#Write a python script that takes the radius of a circle as input and displays the diameter,
circumference and area of the circle.
import math
r=float(input("Enter radius of circle:"))
d=2*r
p=2*math.pi*r
a=math.pi*(r**2)
print(f"For a circle of radius {r}:\nDiam={d}\nCircumference={p}\narea={a}") 
